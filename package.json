
{
  "name": "chitrakatha-studio-os-security-tests",
  "private": true,
  "version": "0.1.0",
  "description": "Firestore security rules tests for Chitrakatha Studio OS",
  "scripts": {
    "test": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.cjs\"",
    "test:permission-v2": "firebase emulators:exec --config firebase.permission-matrix-v2.json --only firestore \"node --test tests/permission-matrix-v2.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.29.2"
  }
}
